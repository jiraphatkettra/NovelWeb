# ==============================================================================
# READVERSE PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. APPLICATION & AUTHENTICATION
NODE_ENV="development" # Set to "production" when deployed
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="generate-a-secure-random-string-at-least-32-characters"
CRON_SECRET="generate-a-secure-secret-for-scheduled-publish"

# 2. DATABASE (PostgreSQL for Production, SQLite for Local Dev)
# Local SQLite Dev:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (Supabase / Neon / AWS RDS):
# DATABASE_URL="postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 3. CLOUDFLARE R2 / AWS S3 OBJECT STORAGE (Persistent Manga & Cover Images)
# (Create a free bucket at dash.cloudflare.com -> R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="readverse-media"
R2_PUBLIC_URL="https://media.readverse.app" # Or https://pub-xxx.r2.dev

# 4. PAYMENT GATEWAY (Omise / GB Prime Pay / Stripe Thailand)
OMISE_PUBLIC_KEY=""
OMISE_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET="whsec_generate_secure_webhook_secret_here"

# 5. TRANSACTIONAL EMAIL (Resend / SMTP for Password Reset & Notifications)
# (Get a free API key at resend.com)
RESEND_API_KEY=""
EMAIL_FROM="ReadVerse <noreply@readverse.app>"
